# Copy to deploy/.env. This file must remain local and untracked.
# The Flutter value is compiled into the web build and must be Zest's public
# HTTPS host plus the trailing catalog path. Do not use a provider key here.
ZEST_API_BASE_URL=https://<public-host>/api/cocktails/

# Keep the premium provider key and a strong database password only in the
# ignored production file. The database hostname is the Compose service name.
COCKTAIL_DB_API_KEY=<private-provider-key>
POSTGRES_USER=zest
POSTGRES_PASSWORD=<strong-database-password>
POSTGRES_DB=zest
DATABASE_URL=postgresql://zest:<strong-database-password>@zest-db:5432/zest

# Browser traffic arrives through Nginx; the backend is not public.
CORS_ORIGINS=http://localhost:5173
