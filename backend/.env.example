# Copy to .env locally. This documented public test key is not a private key.
# Replace ONLY in your ignored .env, or set the process environment.
COCKTAIL_DB_API_KEY=1
PORT=3000
# Exact origins only. Match Flutter's --web-port; no wildcard origins.
CORS_ORIGINS=http://localhost:5173

# Accounts and synced collection (M8, docs/ACCOUNTS.md). Local Compose credentials
# below are non-secret development defaults, not production secrets.
DATABASE_URL=postgres://zest:zest_dev_only@127.0.0.1:5432/zest
POSTGRES_USER=zest
POSTGRES_PASSWORD=zest_dev_only
POSTGRES_DB=zest
# Where photo files are written; ignored by git.
PHOTO_DIR=./data/photos
# 127.0.0.1 only accepts local connections. Set to 0.0.0.0 to reach the
# server from a phone on the same Wi-Fi LAN — see README's LAN warning first.
HOST=127.0.0.1
